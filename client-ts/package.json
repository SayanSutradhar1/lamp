{
  "name": "lamp-client",
  "version": "0.2.0",
  "description": "High-speed binary LMP1/LCB1 client SDK for the Lamp native backend runtime (Node TCP & Browser binary WebSocket)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node_client.ts",
      "default": "./src/node_client.ts"
    },
    "./browser": {
      "types": "./src/browser_client.ts",
      "default": "./src/browser_client.ts"
    }
  },
  "scripts": {
    "test": "node --test tests/client_binary.test.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "lamp",
    "lamp-client",
    "binary-rpc",
    "lmp1",
    "lcb1"
  ]
}
