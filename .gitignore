# ============================================================
# Lamp Framework - Git Ignore Rules
# ============================================================

# Build directories & CMake/Ninja artifacts
/build/
/build-*/
/out/
/cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
Testing/
install_manifest.txt
compile_commands.json
*.ninja
.ninja_deps
.ninja_log

# C / C++ compiled objects, libraries, executables, and debug symbols
*.obj
*.o
*.lo
*.slo
*.d
*.pch
*.gch
*.exe
*.dll
*.so
*.so.*
*.dylib
*.lib
*.a
*.la
*.exp
*.pdb
*.ilk
*.idb
*.ipdb
*.iobj
*.out
*.app

# Clangd / IDE / Editor local state
/.cache/
/.vs/
/.vscode/
/.idea/
*.swp
*.swo
*~

# Node.js / TypeScript SDK build & dependency artifacts
node_modules/
/sdk-ts/dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local environment overrides & secret files
.env
.env.*
!.env.example
*.pem
*.key

# Temporary & OS metadata files
*.tmp
*.temp
*.log
.DS_Store
Thumbs.db
desktop.ini
