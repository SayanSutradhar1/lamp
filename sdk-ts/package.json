{
  "name": "lamp-app",
  "version": "0.2.0",
  "description": "Server-side contract SDK for the Lamp native C++ binary backend runtime (use lamp-client for client contracts)",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "lamp": "./dist/bin/lamp.js",
    "lamp-app": "./dist/bin/lamp.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "node --test tests/sdk.test.ts",
    "example": "node examples/users_service.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  },
  "optionalDependencies": {
    "@sayansutradhar1/lamp-app-win32-x64": "0.2.0",
    "@sayansutradhar1/lamp-app-linux-x64": "0.2.0",
    "@sayansutradhar1/lamp-app-linux-arm64": "0.2.0",
    "@sayansutradhar1/lamp-app-darwin-arm64": "0.2.0",
    "@sayansutradhar1/lamp-app-darwin-x64": "0.2.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "lamp",
    "backend",
    "server-contracts",
    "v8",
    "binary-rpc"
  ]
}
