{
  "name": "lamp",
  "version": "0.2.0",
  "description": "Server-side contract SDK for the Lamp native C++ binary backend runtime (use lamp-client for client contracts)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "lamp": "./bin/lamp.ts"
  },
  "scripts": {
    "test": "node --test tests/sdk.test.ts",
    "example": "node examples/users_service.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "lamp",
    "backend",
    "server-contracts",
    "v8",
    "binary-rpc"
  ]
}
